PORT=3001
NODE_ENV=development

# PostgreSQL — Neon (recommandé) ou local
# Neon : Dashboard → Connection string → pooled (recommended for serverless)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ca-central-1.aws.neon.tech/aidafall?sslmode=require
# Local :
# DATABASE_URL=postgresql://user:pass@localhost:5432/aidafall

# JWT
JWT_SECRET=changez-moi-en-production-avec-une-cle-securisee
JWT_EXPIRES_IN=7d

# Admin par défaut (créé au premier démarrage si absent)
ADMIN_EMAIL=admin@aidafall.ca
ADMIN_PASSWORD=Admin123!

# Agent validateur (créé au premier démarrage si absent)
AGENT_EMAIL=agent@aidafall.ca
AGENT_PASSWORD=Agent123!

# CORS (obligatoire en prod Render — URLs Netlify sans slash final)
CLIENT_URL=http://localhost:5173
WEB_URL=http://localhost:5174
# Apps mobiles : pas utilisé pour CORS navigateur
# MOBILE_URL=*
# CORS_ORIGINS=https://preview--site.netlify.app,https://autre.netlify.app

# Firebase FCM (optionnel — notifications push)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Stripe — paiement sur la plateforme (activé dès que STRIPE_SECRET_KEY est défini)
# PLATFORM_PAYMENTS=false pour désactiver l’UI paiement même avec Stripe configuré
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_PAYMENTS=true

# Google Places (Autocomplete + Details) — requis pour suggestions web
GOOGLE_MAPS_API_KEY=
